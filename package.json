{
  "name": "schoolbooks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "prisma",
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "sharp"
  ],
  "scripts": {
    "dev:genbooks": "bun run --cwd apps/genbooks dev",
    "dev:panel": "bun run --cwd apps/panel_books dev",
    "build:genbooks": "bun run --cwd packages/db generate && bun run --cwd apps/genbooks build",
    "build:panel": "bun run --cwd packages/db generate && bun run --cwd apps/panel_books build",
    "start:genbooks": "bun run --cwd apps/genbooks start",
    "start:panel": "bun run --cwd apps/panel_books start",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:studio": "bun run --cwd packages/db db:studio",
    "test": "bun --no-env-file scripts/run-tests.ts",
    "typecheck": "bun run --cwd packages/storage typecheck && bun run --cwd packages/pdf-pipeline typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/genbooks typecheck && bun run --cwd apps/panel_books typecheck",
    "sync:branches": "bun scripts/sync-app-branches.ts",
    "sync:branches:push": "bun scripts/sync-app-branches.ts --push",
    "test:template-sharing": "bun --no-env-file scripts/run-tests.ts template-sharing",
    "storage:check": "bun packages/storage/scripts/check.ts",
    "storage:migrate": "bun scripts/migrate-storage.ts",
    "storage:audit": "bun scripts/audit-storage.ts",
    "db:migration:manifest": "bun --no-env-file scripts/db-migration/generate-manifest.ts",
    "db:migration:audit": "bun --no-env-file scripts/db-migration/audit.ts",
    "db:migration:copy": "bun --no-env-file scripts/db-migration/copy.ts",
    "db:migration:verify": "bun --no-env-file scripts/db-migration/verify.ts",
    "db:migration:rehearse": "bun --no-env-file scripts/db-migration/local-rehearsal.ts",
    "test:db-migration": "bun --no-env-file test scripts/db-migration",
    "typecheck:db-migration": "bun run --cwd packages/db typecheck:migration",
    "db:migration:payments": "bun --no-env-file scripts/db-migration/reconcile-payments.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "books-storage": "workspace:*",
    "db": "workspace:*",
    "@aws-sdk/client-s3": "^3.0.0"
  }
}

# =============================================================================
# schulplaner-simple — one app (school area + /panel), one database.
# Copy to apps/web/.env (production) or apps/web/.env.local (development),
# and put DATABASE_URL into packages/db/.env for Prisma commands.
# The authoritative schema is apps/web/src/env.js.
# =============================================================================

DATABASE_URL="postgresql://user:password@127.0.0.1:5432/schulplaner_simple"

# Generate with: openssl rand -base64 32 (required in production)
AUTH_SECRET=""
# Public origin; used in sign-in links and order emails.
APP_URL="https://planer.example.de"

# Verified owner email that becomes ADMIN on first sign-in. Further staff are
# added in Panel → Einstellungen → Team.
PANEL_ADMIN_EMAIL=""
# Staff inbox for "Neue Bestellung" notices (optional).
ORDER_NOTIFY_EMAIL=""

# SMTP for sign-in links and order emails. 465 = implicit TLS.
# Outside production mails are only logged unless EMAIL_DEV_SEND="true".
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
EMAIL_DEV_SEND="false"

# Private object storage (Hetzner S3, same package as the genbooks repos).
STORAGE_DRIVER="s3"
S3_BUCKET=""
AWS_REGION="nbg1"
S3_ENDPOINT="https://nbg1.your-objectstorage.com"
S3_PREFIX="clients/schulplaner-simple"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Development only: keep uploads on disk instead (refused in production).
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="../../.local-storage"

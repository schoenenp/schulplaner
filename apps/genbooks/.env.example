# Environment Variables Template
# Copy this file to .env.local and fill in the actual values

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUSHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SUCCESS_URL=https://yourapp.com/payment/success
STRIPE_CANCEL_URL=https://yourapp.com/payment/cancel

# Authentication
AUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true
AUTH_URL=https://yourapp.com
AUTH_GOOGLE_ID=your_google_oauth_client_id_here
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here

# Email Configuration
EMAIL_SERVER_USER=your_email_server_user_here
EMAIL_SERVER_PASSWORD=your_email_server_password_here
EMAIL_SERVER_HOST=your_email_server_host_here
# SMTP submission (STARTTLS). Use 465 only if your provider requires implicit TLS.
EMAIL_SERVER_PORT=587
EMAIL_FROM=noreply@yourapp.com
SHOP_EMAIL=shop@yourapp.com

# Application URLs
BASE_APP_URL=https://yourapp.com
NEXT_PUBLIC_CDN_SERVER_URL=""

# Hetzner Object Storage (shared by this client’s two apps)
S3_BUCKET="pirrot-books"
AWS_REGION="nbg1"
S3_ENDPOINT="https://nbg1.your-objectstorage.com"
S3_PREFIX="clients/pirrot"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CUSTOM_COVER_TEMPLATE_URL=https://yourcdn.com/storage/custom-cover-template.pdf

# Grayscale Conversion
GHOST_GRAYSCALE_API_KEY=your_grayscale_api_key_here

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Other
CANCEL_SECRET=your_cancel_secret_here
NODE_ENV=development

# Migration only: public legacy delivery origin (not the receiving API).
LEGACY_STORAGE_URL="https://cdn.pirrot.de"
# LEGACY_STORAGE_API_KEY=""

# Set true on BOTH services before the database migration; health checks use /api/health.
DATABASE_MAINTENANCE_MODE="false"

# Admin-managed prices are served by the panel. Required in production; without
# them a local shop uses the built-in default prices.
PRICING_SOURCE_URL=https://panel.example.de/api/pricing
PRICING_API_TOKEN=

{
  "name": "pricing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Admin-managed planner prices in a dedicated PostgreSQL database, separate from the shop database.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "default": "./src/store.ts"
    },
    "./connection": {
      "types": "./src/connection.ts",
      "default": "./src/connection.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "bun --no-env-file scripts/import-sqlite.ts",
    "test:postgres": "bun --no-env-file scripts/test-postgres.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
